<%- include("partials/header") %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow">
      <div class="card-body p-4">
        <h3 class="text-center mb-4">Verify OTP</h3>

        <% if (error) { %>
          <div class="alert alert-danger" role="alert">
            <%= error %>
          </div>
        <% } %>

        <% if (message) { %>
          <div class="alert alert-success" role="alert">
            <%= message %>
          </div>
        <% } %>

        <form method="POST" action="/forgot-password/verify-otp">
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input
              type="email"
              class="form-control"
              name="email"
              value="<%= email || '' %>"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label">6-Digit OTP</label>
            <input
              type="text"
              class="form-control"
              name="otp"
              inputmode="numeric"
              pattern="[0-9]{6}"
              maxlength="6"
              required
            />
          </div>

          <button class="btn btn-success w-100">Verify OTP</button>
        </form>

        <form method="POST" action="/forgot-password/resend-otp" class="mt-3">
          <input type="hidden" name="email" value="<%= email || '' %>" />
          <button class="btn btn-outline-secondary w-100" type="submit">
            Resend OTP
          </button>
        </form>

        <p class="text-center mt-3 mb-0 text-muted small">
          OTP expires in 10 minutes. You can request a new OTP after 60 seconds.
        </p>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
