<%- include("partials/header") %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow">
      <div class="card-body p-4">
        <h3 class="text-center mb-4">Create Account</h3>

        <% if (error) { %>
          <div class="alert alert-danger" role="alert">
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/register">

          <!-- Name -->
          <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input
              class="form-control"
              name="name"
              placeholder="Your full name"
              value="<%= formData.name || '' %>"
              required
            />
          </div>

          <!-- Phone -->
          <div class="mb-3">
            <label class="form-label">Mobile Number</label>
            <input
              class="form-control"
              name="phone"
              placeholder="10-digit mobile number"
              value="<%= formData.phone || '' %>"
              required
            />
          </div>

          <!-- Email -->
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input
              type="email"
              class="form-control"
              name="email"
              placeholder="example@email.com"
              value="<%= formData.email || '' %>"
              required
            />
          </div>

          <!-- Password -->
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input
              type="password"
              class="form-control"
              id="password"
              name="password"
              minlength="8"
              required
            />
            <div class="form-text">
              Password must be at least 8 characters and include an uppercase letter, lowercase letter, number, and special character.
            </div>
            <div class="mt-2 small">
              Strength:
              <span id="passwordStrength" class="fw-semibold text-muted">Weak</span>
            </div>
          </div>

          <!-- Role -->
          <div class="mb-3">
            <label class="form-label">Account Type</label>
            <select
              class="form-select"
              name="role"
              id="role"
              onchange="toggleFields()"
              required
            >
              <option value="user" <%= (formData.role || "user") === "user" ? "selected" : "" %>>User</option>
              <option value="provider" <%= formData.role === "provider" ? "selected" : "" %>>Service Provider</option>
            </select>
          </div>

          <!-- USER ADDRESS -->
          <div class="mb-3" id="userAddress">
            <label class="form-label">Address</label>
            <textarea
              class="form-control"
              name="address"
              placeholder="House no, street, area, landmark"
              rows="3"
            ><%= formData.address || '' %></textarea>
          </div>

          <!-- PROVIDER-ONLY FIELDS -->
          <div id="providerFields" style="display: none;">
            <div class="mb-3">
              <label class="form-label">Service Name</label>
              <input
                class="form-control"
                name="service"
                placeholder="e.g. Electrician, Plumber"
                value="<%= formData.service || '' %>"
              />
            </div>

            <div class="mb-3">
              <label class="form-label">Service Location</label>
              <input
                class="form-control"
                name="location"
                placeholder="Area / City"
                value="<%= formData.location || '' %>"
              />
            </div>
          </div>

          <button class="btn btn-success w-100 mt-3">
            Register
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleFields() {
    const role = document.getElementById("role").value;
    const providerFields = document.getElementById("providerFields");
    const userAddress = document.getElementById("userAddress");

    if (role === "provider") {
      providerFields.style.display = "block";
      userAddress.style.display = "none";
    } else {
      providerFields.style.display = "none";
      userAddress.style.display = "block";
    }
  }

  function updatePasswordStrength() {
    const password = document.getElementById("password").value;
    const strengthLabel = document.getElementById("passwordStrength");

    let score = 0;

    if (password.length >= 8) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[a-z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[^A-Za-z0-9]/.test(password)) score++;

    if (score <= 2) {
      strengthLabel.textContent = "Weak";
      strengthLabel.className = "fw-semibold text-danger";
      return;
    }

    if (score === 3 || score === 4) {
      strengthLabel.textContent = "Medium";
      strengthLabel.className = "fw-semibold text-warning";
      return;
    }

    strengthLabel.textContent = "Strong";
    strengthLabel.className = "fw-semibold text-success";
  }

  // Run once on page load
  toggleFields();
  updatePasswordStrength();
  document.getElementById("password").addEventListener("input", updatePasswordStrength);
</script>

<%- include("partials/footer") %>
